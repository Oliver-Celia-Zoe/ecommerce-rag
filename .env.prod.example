# ==========================================
# 生产环境变量模板
# 使用方法：复制此文件为 .env.prod，填入真实值
#   cp .env.prod.example .env.prod
#   然后编辑 .env.prod 填入 DeepSeek API Key 等
# ==========================================
# .env.prod 不入库（.gitignore 已忽略），只在本机存在
# docker compose --env-file .env.prod 读取这些变量

# ---------- DeepSeek API（生产 LLM）----------
# 获取地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-real-deepseek-key-here

# ---------- JWT 密钥（生产必须改！）----------
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=please-change-this-to-a-random-string

# ---------- 数据库密码（生产必须改！）----------
# 生成强密码：python -c "import secrets; print(secrets.token_urlsafe(16))"
# dev 环境不设此项，用默认密码 postgres；prod 必须改成强密码
POSTGRES_PASSWORD=please-change-to-a-strong-password
