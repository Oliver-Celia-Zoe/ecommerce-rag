# ==========================================
# 项目根目录 .gitignore
# ==========================================

# ---------- 环境变量（含敏感信息，绝不入库）----------
.env
.env.prod
.env.dev
!.env.example
!.env.prod.example

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/

# 虚拟环境
.venv/
venv/

# 测试缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- Node.js ----------
node_modules/
dist/

# ---------- IDE ----------
.vscode/
.idea/
*.swp

# ---------- Docker ----------
# docker-compose.yml 等配置文件要入库，不忽略

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db

# ---------- 日志 ----------
*.log
