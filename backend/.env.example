# ==========================================
# Air Fryer AI Assistant - 环境变量模板
# 复制此文件为 .env 并填入真实值
# ==========================================

# ---------- 应用基础配置 ----------
APP_NAME="Air Fryer AI Assistant"
APP_VERSION="0.1.0"
# 环境标识：dev=本地开发（Ollama）、prod=生产（DeepSeek）
APP_ENV=dev
DEBUG=true
LOG_LEVEL=INFO

# ---------- 数据库配置 ----------
# 开发环境（本地 PostgreSQL）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ecommerce_rag

# Docker 环境（容器内 PostgreSQL）
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ecommerce_rag

# ---------- 向量库配置 ----------
# 开发环境（本地 Qdrant）
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=knowledge_chunks

# Docker 环境
# QDRANT_URL=http://qdrant:6333

# ---------- 缓存配置 ----------
# 开发环境（本地 Redis）
REDIS_URL=redis://localhost:6379/0

# Docker 环境
# REDIS_URL=redis://redis:6379/0

# ---------- LLM 配置 ----------
# 提供商: ollama（dev） / openai / deepseek（prod）
# dev  环境默认用 ollama（本地免费）
# prod 环境默认用 deepseek（国内访问稳定、价格低、中文友好）
LLM_PROVIDER=ollama

# Ollama 配置（dev 环境用，本地部署）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:2b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Docker 环境访问宿主机 Ollama
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# OpenAI 配置（兼容接口，可指向任何 OpenAI 兼容服务）
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# DeepSeek 配置（prod 环境用，国内可直连）
# 获取 API Key：https://platform.deepseek.com/
# DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---------- RAG 配置 ----------
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7

# ---------- 安全配置 ----------
# JWT 密钥（生产环境必须修改！）
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------- CORS 配置 ----------
# 前端开发服务器地址
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
