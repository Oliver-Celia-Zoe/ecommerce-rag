# Docker 构建时忽略的文件（避免进镜像，减小体积、保护敏感信息）

# Python 缓存
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/

# 虚拟环境（容器内自己装，不要把本地 .venv 打进镜像）
.venv/
venv/

# IDE 配置
.vscode/
.idea/
*.swp

# Git
.git/
.gitignore

# 环境变量文件（含敏感信息，绝不进镜像！通过 compose 的 environment 注入）
.env
.env.*
!.env.example

# 测试缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Docker 自身
Dockerfile*
.dockerignore

# 操作系统
.DS_Store
Thumbs.db
